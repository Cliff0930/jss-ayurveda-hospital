# ---------------------------------------------------------------------------
# Headless WordPress source
# ---------------------------------------------------------------------------
# Base URL of the WordPress install (no trailing slash).
NEXT_PUBLIC_WP_URL=https://wordpress-1420178-6266636.cloudwaysapps.com

# Hostname only — used by next/image `remotePatterns` (see next.config.ts).
NEXT_PUBLIC_WP_HOSTNAME=wordpress-1420178-6266636.cloudwaysapps.com

# Seconds between background re-fetches of WordPress content (ISR).
# 300 = content edited in WP appears on the site within 5 minutes.
WP_REVALIDATE_SECONDS=300

# ---------------------------------------------------------------------------
# On-demand revalidation
# ---------------------------------------------------------------------------
# Shared secret for POST /api/revalidate. Generate a long random string.
# Call it from a WordPress `save_post` hook to publish changes instantly.
REVALIDATE_SECRET=change-me-to-a-long-random-string

# ---------------------------------------------------------------------------
# Enquiry form
# ---------------------------------------------------------------------------
# Where /api/enquiry forwards submissions. Leave blank to log-only in dev.
ENQUIRY_TO_EMAIL=contact@jssamch.org
# Optional: an SMTP/webhook endpoint (e.g. Resend, Formspree, n8n) to POST to.
ENQUIRY_WEBHOOK_URL=

# ---------------------------------------------------------------------------
# Site
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.jssayurvedahospital.org
